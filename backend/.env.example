# Backend configuration template (M1-02).
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# .env is git-ignored and must never be committed. This file holds LOCAL defaults only.
# The database password below is the local Docker Compose one (docker-compose.yml),
# which must never be used outside local development.

# PostgreSQL connection for SQLAlchemy + psycopg 3. Required: the app will not start without it.
DATABASE_URL=postgresql+psycopg://milk_user:milk_password_local_only@localhost:5432/milk_delivery

# Frontend origins allowed to call the API (CORS, used from M3-08). Comma-separated.
CORS_ORIGINS=http://localhost:5173

# Secret that signs login tokens (JWT, #89). Required, at least 32 characters.
# Make your OWN for .env (never commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-of-48-characters

# Minutes a login stays valid (5–1440).
JWT_EXPIRE_MINUTES=60

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# local, test or production.
APP_ENV=local
