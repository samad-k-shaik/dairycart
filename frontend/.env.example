# Copy to .env.local to change these (Vite reads them when `npm run dev` starts).

# Backend API address, including /api/v1. The backend must allow this frontend's origin
# in its CORS_ORIGINS setting (backend/.env).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true = use the M2 mock data in the browser instead of the backend (offline UI work only).
VITE_USE_MOCKS=false
